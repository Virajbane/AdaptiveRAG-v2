# ==================== MONGODB ====================
# Required: Password for the MongoDB root user (created on first init).
# NOTE: Must exactly match the password in backend/.env MONGODB_URL
MONGO_PASSWORD=your_secure_mongo_password

# ==================== REDIS ====================
# Required: Password for the Redis container.
# NOTE: Must exactly match the password in backend/.env REDIS_URL
REDIS_PASSWORD=your_secure_redis_password

# ==================== QDRANT ====================
# Optional: Set this to enable API key auth for Qdrant.
# NOTE: Must match QDRANT_API_KEY in backend/.env. Leave blank for unauthenticated local dev.
QDRANT_API_KEY=your_qdrant_api_key

# ==================== SECURITY ====================
# Required: JWT / App secret used to sign session tokens.
# NOTE: This must be named SECRET_KEY. It must match SECRET_KEY in backend/.env.
SECRET_KEY=your_super_secret_jwt_key_min_32_chars

# Required: Encryption key for database-level encryption (min 32 chars).
ENCRYPTION_KEY=your_encryption_key_min_32_chars

# ==================== EXTERNAL SERVICES ====================
# Optional: Required if Tool Agent web search is enabled
TAVILY_API_KEY=your_tavily_api_key

# ==================== ENVIRONMENT & LOGGING ====================
ENVIRONMENT=production
LOG_LEVEL=INFO

# ==================== FRONTEND / DEPLOYMENT ====================
# Required for production: The backend API URL that the Next.js frontend calls.
NEXT_PUBLIC_API_URL=http://your-domain.com
# Required for production: URL for the frontend application
FRONTEND_URL=http://your-domain.com
# Required for production: CORS origins
CORS_ORIGINS=http://your-domain.com