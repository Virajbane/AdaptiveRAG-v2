```gitignore
# ===========================================
# Python
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd


# Generated project files
project_tree.txt

# Python
.python-version
pip-wheel-metadata/

# Environment
.env.*

# Vercel / Turbopack
.vercel/
.turbo/

# Temporary
*.orig
.history/

project_tree.txt

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
frontend/venv/

# Pytest
.pytest_cache/
.cache/


# Coverage
.coverage
coverage/
coverage.xml
htmlcov/
.pytest_results.xml

# Type Checkers
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ===========================================
# Environment Files
# ===========================================
.env
.env.local
.env.development
.env.production
.env.test

backend/.env
frontend/.env

# Keep examples
!.env.example
!backend/.env.example
!frontend/.env.example

# ===========================================
