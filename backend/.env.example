# ==================== APP ====================
APP_NAME=RAG 2.0 System
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== DATABASE ====================
# Required: Full Mongo connection string. Must match MONGO_INITDB_ROOT_USERNAME/PASSWORD in root .env
MONGODB_URL=mongodb://admin:password123@localhost:27017/rag_db?authSource=admin
QDRANT_URL=http://localhost:6333
# Optional: Set this if Qdrant requires authentication (must match root .env QDRANT_API_KEY)
QDRANT_API_KEY=
# Required: Redis connection string. Must match REDIS_PASSWORD in root .env
REDIS_URL=redis://localhost:6379/0

# ==================== LLM ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text
ENABLE_RERANKER=True

# ==================== API KEYS (Optional) ====================
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Required if Tool Agent web search is enabled
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
VOYAGE_API_KEY=

# ==================== EMAIL NOTIFICATIONS (Optional) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==================== LANGSMITH (Optional) ====================
LANGCHAIN_TRACING_V2=False
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-2.0-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==================== DOCUMENT PROCESSING ====================
ENABLE_PICTURE_DESCRIPTION=True
PICTURE_DESCRIPTION_MODEL=qwen2.5vl:3b

# ==================== SECURITY ====================
# Required: Use a long random string for session tokens
SECRET_KEY=change-this-to-a-long-random-string-for-real-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
# Required: Min 32 chars
ENCRYPTION_KEY=your_encryption_key_min_32_chars

# ==================== CORS ====================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000